---
/* Separate, shareable menu pages: /menu/main, /menu/oap, /menu/kids, /menu/specials
   Content comes from src/config/menuData.ts. À la carte items show a price per
   dish; fixed-price set menus show the deal price at the top and group dishes
   by course. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookCta from '../../components/BookCta.astro';
import PortcullisDivider from '../../components/PortcullisDivider.astro';
import { menuData } from '../../config/menuData';
import { withBase } from '../../config/site';

export async function getStaticPaths() {
  return menuData.map((m) => ({ params: { menu: m.slug }, props: { menu: m } }));
}

const { menu } = Astro.props;
---

<BaseLayout title={menu.title} description={`${menu.title} at The Portcullis, Arbroath. ${menu.blurb}`}>
  <Header />
  <main id="main">
    <!-- Page header -->
    <section class="bg-porty-red px-4 pb-14 pt-28 text-center text-porty-cream sm:px-6 sm:pt-32">
      <p class="font-body text-xs font-bold uppercase tracking-[0.22em] text-porty-gold">The Portcullis · Arbroath</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">{menu.title}</h1>
      <p class="mx-auto mt-4 max-w-xl text-porty-cream/85">{menu.blurb}</p>
      <PortcullisDivider class="mt-6" />
    </section>

    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
      {/* Fixed-price / deal banner for set menus */}
      {menu.deal && (
        <div class="mx-auto mb-12 max-w-xl rounded-3xl border-2 border-porty-gold/60 bg-porty-cream p-6 text-center">
          {menu.intro && <p class="text-sm font-semibold uppercase tracking-wide text-porty-red/70">{menu.intro}</p>}
          <p class="font-display text-3xl font-semibold text-porty-red sm:text-4xl">{menu.deal}</p>
          {menu.availability && <p class="mt-2 text-porty-dark/75">{menu.availability}</p>}
        </div>
      )}

      {
        menu.categories.map((cat) => (
          <section class="mb-12 last:mb-0">
            <h2 class="font-display text-2xl font-semibold text-porty-red">{cat.name}</h2>
            {cat.note && <p class="mt-1 text-sm italic text-porty-dark/60">{cat.note}</p>}
            <div class="mt-2 rule-gold"></div>
            <ul class="mt-5 space-y-5">
              {cat.items.map((item) => (
                <li class={item.price ? 'flex items-baseline gap-3' : ''}>
                  <div class="flex-1">
                    <h3 class="font-display text-lg font-semibold text-porty-dark">
                      {item.name}
                      {item.tags && (
                        <span class="ml-2 align-middle text-xs font-semibold uppercase tracking-wide text-porty-red/45">
                          {item.tags}
                        </span>
                      )}
                    </h3>
                    {item.description && (
                      <p class="mt-0.5 text-sm leading-relaxed text-porty-dark/70">{item.description}</p>
                    )}
                  </div>
                  {item.price && (
                    <>
                      <span aria-hidden="true" class="mb-1 flex-1 border-b border-dotted border-porty-red/25"></span>
                      <span class="shrink-0 font-display text-lg font-semibold text-porty-red">{item.price}</span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      {menu.legend && (
        <p class="mt-12 text-center text-xs font-semibold uppercase tracking-wide text-porty-red/50">{menu.legend}</p>
      )}
      {menu.footnote && (
        <p class="mx-auto mt-4 max-w-xl text-center text-sm leading-relaxed text-porty-dark/60">{menu.footnote}</p>
      )}

      <div class="mt-14 flex flex-col items-center gap-4 rounded-3xl bg-porty-cream p-8 text-center ring-1 ring-porty-red/10">
        <p class="font-display text-xl text-porty-red">Fancy a table?</p>
        <p class="max-w-md text-porty-dark/75">Menus may vary. Prices and dishes are subject to change, give us a shout to book.</p>
        <BookCta variant="solid" />
        <a href={withBase('/menus')} class="inline-flex min-h-[48px] items-center rounded-full border-2 border-porty-red px-6 py-3 font-semibold text-porty-red transition-colors hover:bg-porty-red hover:text-porty-cream">
          All menus
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
