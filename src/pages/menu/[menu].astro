---
/* Separate, shareable menu pages: /menu/main, /menu/oap, /menu/kids, /menu/specials
   Items come from the `menu` content collection and are grouped by category. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookButton from '../../components/BookButton.astro';
import PortcullisDivider from '../../components/PortcullisDivider.astro';
import { getCollection } from 'astro:content';
import { menus } from '../../config/site';

export async function getStaticPaths() {
  const all = await getCollection('menu');
  return menus.map((m) => ({
    params: { menu: m.slug },
    props: {
      meta: m,
      items: all
        .filter((i) => i.data.menu === m.slug)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { meta, items } = Astro.props;

// Group items by category, preserving first-seen order.
const categories: string[] = [];
const grouped: Record<string, typeof items> = {};
for (const item of items) {
  const c = item.data.category;
  if (!grouped[c]) {
    grouped[c] = [];
    categories.push(c);
  }
  grouped[c].push(item);
}
---

<BaseLayout title={meta.title} description={`${meta.title} at The Portcullis, Arbroath. ${meta.blurb}`}>
  <Header />
  <main id="main">
    <!-- Page header -->
    <section class="bg-porty-red px-4 pb-14 pt-16 text-center text-porty-cream sm:px-6 sm:pt-20">
      <p class="font-body text-xs font-bold uppercase tracking-[0.22em] text-porty-gold">
        The Portcullis · Arbroath
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">{meta.title}</h1>
      <p class="mx-auto mt-4 max-w-xl text-porty-cream/85">{meta.blurb}</p>
      <PortcullisDivider class="mt-6" />
    </section>

    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
      {
        items.length === 0 ? (
          <p class="text-center text-lg text-porty-dark/70">
            This menu is being updated — please check back soon or call us on{' '}
            <a href="tel:+441241463117" class="font-semibold text-porty-red underline">01241 463117</a>.
          </p>
        ) : (
          categories.map((cat) => (
            <section class="mb-12 last:mb-0">
              <h2 class="font-display text-2xl font-semibold text-porty-red">{cat}</h2>
              <div class="mt-2 rule-gold"></div>
              <ul class="mt-5 space-y-5">
                {grouped[cat].map((item) => (
                  <li class="flex items-baseline gap-3">
                    <div class="flex-1">
                      <h3 class="font-display text-lg font-semibold text-porty-dark">{item.data.name}</h3>
                      {item.data.description && (
                        <p class="mt-0.5 text-sm leading-relaxed text-porty-dark/70">{item.data.description}</p>
                      )}
                    </div>
                    <span aria-hidden="true" class="mb-1 flex-1 border-b border-dotted border-porty-red/25"></span>
                    <span class="shrink-0 font-display text-lg font-semibold text-porty-red">{item.data.price}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        )
      }

      <div class="mt-14 flex flex-col items-center gap-4 rounded-3xl bg-porty-cream p-8 text-center ring-1 ring-porty-red/10">
        <p class="font-display text-xl text-porty-red">Fancy a table?</p>
        <p class="max-w-md text-porty-dark/75">Menus may vary. Prices and dishes are subject to change — give us a shout to book.</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <BookButton />
          <a href="/#menus" class="inline-flex min-h-[48px] items-center rounded-full border-2 border-porty-red px-6 py-3 font-semibold text-porty-red transition-colors hover:bg-porty-red hover:text-porty-cream">
            All menus
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
