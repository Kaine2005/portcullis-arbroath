---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import MenusSection from '../components/MenusSection.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout title="Our Menus" description="Browse the menus at The Portcullis, Arbroath, our main menu, OAP menu, kids menu and chef's specials.">
  <Header />
  <main id="main">
    <PageHero
      title="Our Menus"
      eyebrow="Eat & Drink"
      intro="Great-value deals and something for the whole family. Pick a menu below to see what's on."
    />
    <MenusSection bare />
    <CtaBand />
  </main>
  <Footer />
</BaseLayout>
