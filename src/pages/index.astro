---
/* Homepage: a warm overview of everything The Porty offers, with links out to
   the dedicated pages for detail (and SEO). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import MenusSection from '../components/MenusSection.astro';
import Specials from '../components/Specials.astro';
import Events from '../components/Events.astro';
import Functions from '../components/Functions.astro';
import BookCta from '../components/BookCta.astro';
import PortcullisDivider from '../components/PortcullisDivider.astro';
import Footer from '../components/Footer.astro';
import { site, withBase } from '../config/site';

// Quick-link cards to the remaining pages.
const explore = [
  {
    href: '/games',
    title: 'The Games Room',
    copy: 'Pool tables, dart boards, game nights, and our very own pool team.',
  },
  {
    href: '/community',
    title: 'In the Community',
    copy: 'Proudly backing Arbroath’s local clubs, teams and good causes.',
  },
  {
    href: '/gallery',
    title: "Down Porty's Lens",
    copy: 'Parties, band nights and big nights out, straight from the pub.',
  },
];
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <MenusSection />
    <Specials />
    <Events />
    <Functions />

    <!-- Explore more -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">More at The Porty</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-porty-red sm:text-4xl">Have a look around</h2>
        <PortcullisDivider class="mt-6" />
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-3">
        {
          explore.map((c) => (
            <a
              href={withBase(c.href)}
              data-reveal
              class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-porty-red/10 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-porty-gold/50 hover:shadow-xl hover:shadow-porty-red/10"
            >
              <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-porty-gold to-porty-red transition-transform duration-300 group-hover:scale-x-100" />
              <div>
                <h3 class="font-display text-2xl font-semibold text-porty-red">{c.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-porty-dark/75">{c.copy}</p>
              </div>
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-porty-red">
                Explore
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Find us teaser -->
    <section class="bg-porty-dark px-4 py-16 text-center text-porty-cream sm:px-6 sm:py-24">
      <div class="mx-auto max-w-2xl" data-reveal>
        <p class="font-body text-xs font-bold uppercase tracking-[0.22em] text-porty-gold">Find Us</p>
        <h2 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">Come On In</h2>
        <address class="mt-4 not-italic text-lg text-porty-cream/85">
          {site.address.street}, {site.address.town}, {site.address.postcode}
        </address>
        <p class="mt-1 text-porty-cream/70">Bookings by phone or email, we'll get you sorted.</p>
        <div class="mt-8 flex flex-col items-center gap-4">
          <BookCta variant="gold" onDark />
          <a href={withBase('/find-us')} class="text-sm font-semibold text-porty-gold underline underline-offset-4 hover:text-porty-cream">
            Opening hours, directions &amp; map
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
