---
/* Full-bleed hero. The photo loads eagerly (it's the LCP element). A burgundy
   gradient overlay (--porty-dark ~55% -> transparent) keeps the white text
   legible across the whole image on every screen size. */
import { site, images } from '../config/site';
import BookCta from './BookCta.astro';
---

<section id="top" class="relative flex min-h-[92svh] items-end overflow-hidden">
  <!-- Background photo -->
  <img
    src={images.hero}
    alt="The Portcullis pub and restaurant in Arbroath, with outdoor seating"
    class="absolute inset-0 h-full w-full object-cover"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    width="1920"
    height="1280"
  />

  <!-- Burgundy-tinted overlay: strongest at the bottom where the text sits,
       fading up, plus a subtle darkening across the whole image. -->
  <div
    class="absolute inset-0"
    style="background:
      linear-gradient(to top, rgba(92,14,23,0.88) 0%, rgba(92,14,23,0.55) 42%, rgba(92,14,23,0.18) 75%, rgba(92,14,23,0.10) 100%);"
    aria-hidden="true"
  >
  </div>

  <!-- Content -->
  <div class="relative mx-auto w-full max-w-7xl px-4 pb-14 pt-28 sm:px-6 sm:pb-20 lg:pb-24">
    <p class="hero-rise mb-3 font-body text-xs font-semibold uppercase tracking-[0.28em] text-porty-gold sm:text-sm" style="animation-delay:0.05s">
      Pub · Kitchen · Function Suite
    </p>
    <h1 class="hero-rise max-w-3xl font-display text-[3.25rem] font-semibold leading-[1.02] text-porty-cream drop-shadow-sm sm:text-6xl lg:text-7xl" style="animation-delay:0.15s">
      The Portcullis
    </h1>
    <div class="hero-rise mt-5 flex items-center gap-3" style="animation-delay:0.3s">
      <span class="h-0.5 w-12 rounded bg-porty-gold"></span>
      <p class="max-w-xl font-display text-xl italic text-porty-cream/95 sm:text-2xl">
        {site.tagline}
      </p>
    </div>

    <div class="hero-rise mt-8" style="animation-delay:0.45s">
      <BookCta size="lg" variant="gold" onDark callLabel={`Call to book · ${site.phone}`} />
    </div>
  </div>
</section>
