---

<ul class:list={['flex flex-wrap items-center gap-2', extra]}>
  {
    socials.map((s) => (
      <li>
        <a
          href={s.url}
          target="_blank"
          rel="noopener"
          aria-label={s.name}
          title={s.name}
          class="group flex h-11 w-11 items-center justify-center rounded-full text-porty-red transition-all duration-200 hover:-translate-y-0.5 hover:scale-105 hover:text-porty-dark focus-visible:text-porty-dark"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-7 w-7"
          >
            <path d={icons[s.name]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
