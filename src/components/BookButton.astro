---
/* "Book a Table" button, opens WhatsApp with a pre-filled message.
   NOTE: the wa.me/message/<code> short link opens the business's WhatsApp
   chat. We append the requested pre-filled text; WhatsApp fills it in where
   supported. */
import { site } from '../config/site';

interface Props {
  label?: string;
  message?: string;
  variant?: 'solid' | 'ghost' | 'gold';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  label = 'Book a Table',
  message = "Hi, I'd like to book a table for [date / time / number of people]",
  variant = 'solid',
  size = 'md',
  class: extra = '',
} = Astro.props;

const href = `${site.whatsapp}?text=${encodeURIComponent(message)}`;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold tracking-wide transition-all duration-200 cursor-pointer focus-visible:outline-none';
const sizes = {
  sm: 'px-4 py-2 text-sm min-h-[40px]',
  md: 'px-6 py-3 text-base min-h-[48px]',
  lg: 'px-8 py-4 text-lg min-h-[52px]',
};
const variants = {
  solid:
    'bg-porty-red text-porty-cream shadow-lg shadow-porty-red/25 hover:bg-porty-dark hover:-translate-y-0.5',
  gold: 'bg-porty-gold text-porty-dark shadow-lg shadow-porty-gold/30 hover:brightness-105 hover:-translate-y-0.5',
  ghost:
    'border-2 border-porty-cream/80 text-porty-cream hover:bg-porty-cream hover:text-porty-red',
};
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class:list={[base, sizes[size], variants[variant], extra]}
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="h-5 w-5 shrink-0"
  >
    <path
      d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-1.8-.9-3-1.6-4.2-3.6-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5 0-.2-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.3 5.2 4.6.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.4z"
    />
    <path
      d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20z"
    />
  </svg>
  {label}
</a>
