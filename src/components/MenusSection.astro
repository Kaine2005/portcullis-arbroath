---
/* Menus, cards that link to the separate, shareable menu pages. */
import { menus, withBase } from '../config/site';
import PortcullisDivider from './PortcullisDivider.astro';

interface Props {
  bare?: boolean; // hide the centered header (page provides its own hero)
}
const { bare = false } = Astro.props;
---

<section id="menus" class="scroll-mt-20 bg-porty-cream px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    {!bare && (
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Eat &amp; Drink</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-porty-red sm:text-4xl">Our Menus</h2>
        <p class="mt-4 text-lg text-porty-dark/80">
          Great-value deals and something for the whole family. Tap a menu to see what's on.
        </p>
        <PortcullisDivider class="mt-6" />
      </div>
    )}

    <div class:list={['grid gap-5 sm:grid-cols-2 lg:grid-cols-4', !bare && 'mt-12']}>
      {
        menus.map((m) => (
          <a
            href={withBase(`/menu/${m.slug}`)}
            data-reveal
            class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-porty-red/10 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-porty-gold/50 hover:shadow-xl hover:shadow-porty-red/10"
          >
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-porty-gold to-porty-red transition-transform duration-300 group-hover:scale-x-100"></span>
            <div>
              <h3 class="font-display text-2xl font-semibold text-porty-red">
                {m.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-porty-dark/75">
                {m.blurb}
              </p>
            </div>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-porty-red">
              View menu
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
