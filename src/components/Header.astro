---
/* Sticky, slim header: crest + name on the left, page nav in the middle
   (desktop), a persistent tap-to-call on the right. On mobile/tablet the nav
   collapses into a toggle panel with a Call + Email booking CTA at the bottom.
   Nav links come from config and are base-aware for GitHub Pages. */
import { site, images, nav, withBase } from '../config/site';
import BookCta from './BookCta.astro';

// Highlight the current page. Astro.url.pathname includes the base prefix.
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return path === target || (href !== '/' && path.startsWith(target + '/'));
};
---

<header class="sticky top-0 z-50 border-b border-porty-red/10 bg-porty-cream/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-3 sm:gap-3 sm:px-6 lg:h-[4.5rem]">
    <!-- Crest + name -->
    <a href={withBase('/')} class="flex min-w-0 items-center gap-2.5" aria-label={`${site.name} home`}>
      <img
        src={images.logo}
        alt={`${site.name} crest`}
        width="44"
        height="44"
        class="h-10 w-10 shrink-0 object-contain lg:h-11 lg:w-11"
        onerror="this.style.display='none'"
      />
      <span class="truncate font-display text-base font-semibold leading-none text-porty-red sm:text-xl">
        The Portcullis
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-4 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors hover:text-porty-red',
              isActive(item.href) ? 'text-porty-red' : 'text-porty-dark/80',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Persistent actions -->
    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        href={site.phoneHref}
        class="hidden h-11 items-center gap-2 rounded-full bg-porty-red px-4 text-sm font-semibold text-porty-cream transition-colors hover:bg-porty-dark lg:inline-flex"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .5 1 1V20c0 .6-.5 1-1 1A17 17 0 0 1 3 4c0-.6.5-1 1-1h3.5c.6 0 1 .5 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1l-2.3 2.3z" />
        </svg>
        Call to book
      </a>
      <a
        href={site.phoneHref}
        class="flex h-11 w-11 items-center justify-center rounded-full text-porty-red transition-colors hover:bg-porty-red/10 lg:hidden"
        aria-label={`Call ${site.phone}`}
        title={`Call ${site.phone}`}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
          <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .5 1 1V20c0 .6-.5 1-1 1A17 17 0 0 1 3 4c0-.6.5-1 1-1h3.5c.6 0 1 .5 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1l-2.3 2.3z" />
        </svg>
      </a>

      <!-- Mobile menu toggle -->
      <button
        type="button"
        id="nav-toggle"
        class="flex h-11 w-11 items-center justify-center rounded-full text-porty-red transition-colors hover:bg-porty-red/10 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <nav id="mobile-nav" class="hidden border-t border-porty-red/10 bg-porty-cream lg:hidden" aria-label="Primary mobile">
    <ul class="mx-auto flex max-w-7xl flex-col px-4 py-2 sm:px-6">
      {
        nav.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block border-b border-porty-red/5 py-3 text-base font-medium hover:text-porty-red',
                isActive(item.href) ? 'text-porty-red' : 'text-porty-dark',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-4 pb-2">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-porty-dark/50">Book a table</p>
        <BookCta size="md" variant="solid" stack callLabel={`Call · ${site.phone}`} />
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  // Close the panel after tapping a link
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      panel.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
