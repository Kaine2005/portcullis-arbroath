---
/* "Down Porty's Lens" — a photo dump of parties, events and nights at the pub.
   No photos yet, so we lay out branded placeholder tiles in a lively mosaic so
   the page already looks the part. Swap tiles for <img> as photos come in. */
import Placeholder from './Placeholder.astro';

// Varied aspect ratios give the grid a natural, scrapbook feel.
const tiles = ['4/3', '1/1', '3/4', '1/1', '4/3', '3/4', '3/4', '4/3', '1/1', '4/3', '3/4', '1/1'];
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
    <p class="text-lg text-porty-dark/80">
      Big nights, birthdays, band nights and everything in between. Here's a peek
      at life at The Porty, straight from the party.
    </p>
  </div>

  <div class="columns-2 gap-4 sm:columns-3 lg:columns-4 [&>*]:mb-4">
    {tiles.map((r, i) => (
      <div data-reveal class="break-inside-avoid">
        <Placeholder label={i === 0 ? 'Photos coming soon' : ' '} ratio={r} />
      </div>
    ))}
  </div>

  <div class="mx-auto mt-14 max-w-2xl rounded-3xl bg-porty-cream p-8 text-center ring-1 ring-porty-red/10" data-reveal>
    <p class="font-display text-xl text-porty-red">Snapped a good one?</p>
    <p class="mt-3 text-porty-dark/80">
      Tag <span class="font-semibold text-porty-red">@theportyarbroath</span> on
      Instagram and you might just see yourself up here.
    </p>
  </div>
</section>
