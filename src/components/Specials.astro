---
/* Weekly Specials — CMS-driven. Reads the `specials` collection and shows each
   as a card. Edited by the owner at /admin. */
import { getCollection } from 'astro:content';
import PortcullisDivider from './PortcullisDivider.astro';

const specials = (await getCollection('specials')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="specials" class="scroll-mt-20 bg-porty-dark px-4 py-16 text-porty-cream sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="font-body text-xs font-bold uppercase tracking-[0.22em] text-porty-gold">
        Great Value
      </p>
      <h2 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
        Weekly Specials
      </h2>
      <p class="mt-4 text-lg text-porty-cream/80">
        Our regular deals — from pensioner lunches to midweek treats and kids
        eating free.
      </p>
      <PortcullisDivider class="mt-6" />
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        specials.map((s) => (
          <article
            data-reveal
            class="flex flex-col rounded-2xl bg-porty-cream/5 p-6 ring-1 ring-porty-gold/25 backdrop-blur-sm"
          >
            <div class="flex items-start gap-3">
              {s.data.emoji && (
                <span class="text-3xl leading-none" aria-hidden="true">
                  {s.data.emoji}
                </span>
              )}
              <h3 class="font-display text-2xl font-semibold text-porty-gold">
                {s.data.title}
              </h3>
            </div>
            {(s.data.days || s.data.times) && (
              <p class="mt-3 inline-flex w-fit items-center gap-2 rounded-full bg-porty-red/40 px-3 py-1 text-sm font-medium text-porty-cream">
                {[s.data.days, s.data.times].filter(Boolean).join(' · ')}
              </p>
            )}
            <p class="mt-4 leading-relaxed text-porty-cream/85">
              {s.data.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
