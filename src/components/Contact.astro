---
/* Find Us / Contact — address, tap-to-call, email, opening hours, embedded map,
   flat-burgundy socials, and a lightweight booking/contact form.

   FORM HANDLING:
   - Primary: Netlify Forms (the data-netlify attributes below). On Netlify this
     just works — submissions appear in your dashboard and can email
     contact@portcullis-arbroath.co.uk (set up in Netlify > Forms > Notifications).
   - Fallback: Formspree. If you are NOT on Netlify, delete the two data-netlify
     lines + the hidden inputs, and set:
       action="https://formspree.io/f/XXXXXXXX" method="POST"
     (create a free form at formspree.io pointed at contact@portcullis-arbroath.co.uk)
*/
import { site } from '../config/site';
import BookButton from './BookButton.astro';
import SocialLinks from './SocialLinks.astro';

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(
  `${site.address.street}, ${site.address.town} ${site.address.postcode}`
)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `The Portcullis, ${site.address.street}, ${site.address.town} ${site.address.postcode}`
)}`;
---

<section id="contact" class="scroll-mt-20 bg-porty-cream px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Find Us</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-porty-red sm:text-4xl">
        Come On In
      </h2>
      <p class="mt-4 text-lg text-porty-dark/80">
        We're in the heart of Arbroath. Pop in, give us a call, or book your
        table below.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- Left: details, hours, map, socials -->
      <div data-reveal class="space-y-8">
        <div class="rounded-3xl border border-porty-red/10 bg-white p-6 shadow-sm sm:p-8">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <h3 class="font-display text-lg font-semibold text-porty-red">Address</h3>
              <address class="mt-2 not-italic leading-relaxed text-porty-dark/85">
                {site.name}<br />
                {site.address.street}<br />
                {site.address.town}<br />
                {site.address.postcode}
              </address>
              <a href={mapLink} target="_blank" rel="noopener" class="mt-2 inline-block text-sm font-semibold text-porty-red underline underline-offset-2 hover:text-porty-dark">
                Get directions
              </a>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold text-porty-red">Get in touch</h3>
              <p class="mt-2 space-y-1">
                <a href={site.phoneHref} class="block font-semibold text-porty-dark hover:text-porty-red">
                  {site.phone}
                </a>
                <a href={`mailto:${site.email}`} class="block break-words text-porty-dark/85 hover:text-porty-red">
                  {site.email}
                </a>
              </p>
            </div>
          </div>

          <div class="my-6 rule-gold"></div>

          <h3 class="font-display text-lg font-semibold text-porty-red">Opening Hours</h3>
          <p class="mt-1 text-xs font-medium uppercase tracking-wide text-porty-dark/50">
            Placeholder — please confirm your real hours
          </p>
          <dl class="mt-3 divide-y divide-porty-red/10">
            {
              site.hours.map((h) => (
                <div class="flex justify-between py-2 text-porty-dark/85">
                  <dt>{h.days}</dt>
                  <dd class="font-medium">{h.time}</dd>
                </div>
              ))
            }
          </dl>

          <div class="my-6 rule-gold"></div>

          <h3 class="font-display text-lg font-semibold text-porty-red">Follow us</h3>
          <SocialLinks class="mt-3" />
        </div>

        <div class="overflow-hidden rounded-3xl border border-porty-red/10 shadow-sm">
          <iframe
            title={`Map to ${site.name}`}
            src={mapSrc}
            class="h-72 w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <!-- Right: booking / contact form -->
      <div data-reveal class="rounded-3xl bg-porty-dark p-6 text-porty-cream shadow-xl sm:p-8">
        <h3 class="font-display text-2xl font-semibold">Book a Table</h3>
        <p class="mt-2 text-porty-cream/80">
          The quickest way to book is WhatsApp — or send us the details below and
          we'll be in touch.
        </p>
        <BookButton class="mt-4" variant="gold" />

        <div class="my-6 flex items-center gap-4 text-porty-cream/50">
          <span class="h-px flex-1 bg-porty-cream/20"></span>
          <span class="text-xs uppercase tracking-widest">or send a message</span>
          <span class="h-px flex-1 bg-porty-cream/20"></span>
        </div>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="space-y-4"
        >
          <!-- Netlify needs these two hidden inputs; harmless elsewhere -->
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div>
            <label for="c-name" class="mb-1 block text-sm font-medium text-porty-cream/90">Name</label>
            <input id="c-name" name="name" type="text" required autocomplete="name"
              class="w-full rounded-xl border border-porty-cream/20 bg-porty-cream/10 px-4 py-3 text-porty-cream placeholder-porty-cream/40 focus:border-porty-gold focus:bg-porty-cream/15 focus:outline-none" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="c-phone" class="mb-1 block text-sm font-medium text-porty-cream/90">Phone</label>
              <input id="c-phone" name="phone" type="tel" autocomplete="tel"
                class="w-full rounded-xl border border-porty-cream/20 bg-porty-cream/10 px-4 py-3 text-porty-cream placeholder-porty-cream/40 focus:border-porty-gold focus:bg-porty-cream/15 focus:outline-none" />
            </div>
            <div>
              <label for="c-email" class="mb-1 block text-sm font-medium text-porty-cream/90">Email</label>
              <input id="c-email" name="email" type="email" autocomplete="email"
                class="w-full rounded-xl border border-porty-cream/20 bg-porty-cream/10 px-4 py-3 text-porty-cream placeholder-porty-cream/40 focus:border-porty-gold focus:bg-porty-cream/15 focus:outline-none" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="c-datetime" class="mb-1 block text-sm font-medium text-porty-cream/90">Preferred date &amp; time</label>
              <input id="c-datetime" name="datetime" type="text" placeholder="e.g. Sat 12th, 7pm"
                class="w-full rounded-xl border border-porty-cream/20 bg-porty-cream/10 px-4 py-3 text-porty-cream placeholder-porty-cream/40 focus:border-porty-gold focus:bg-porty-cream/15 focus:outline-none" />
            </div>
            <div>
              <label for="c-people" class="mb-1 block text-sm font-medium text-porty-cream/90">Number of people</label>
              <input id="c-people" name="people" type="number" min="1" inputmode="numeric" placeholder="e.g. 4"
                class="w-full rounded-xl border border-porty-cream/20 bg-porty-cream/10 px-4 py-3 text-porty-cream placeholder-porty-cream/40 focus:border-porty-gold focus:bg-porty-cream/15 focus:outline-none" />
            </div>
          </div>

          <div>
            <label for="c-message" class="mb-1 block text-sm font-medium text-porty-cream/90">Message</label>
            <textarea id="c-message" name="message" rows="3" placeholder="Any special requests?"
              class="w-full rounded-xl border border-porty-cream/20 bg-porty-cream/10 px-4 py-3 text-porty-cream placeholder-porty-cream/40 focus:border-porty-gold focus:bg-porty-cream/15 focus:outline-none"></textarea>
          </div>

          <button type="submit"
            class="inline-flex min-h-[48px] w-full items-center justify-center rounded-full bg-porty-gold px-6 py-3 font-semibold text-porty-dark transition-all duration-200 hover:-translate-y-0.5 hover:brightness-105 cursor-pointer">
            Send booking request
          </button>
          <p class="text-center text-xs text-porty-cream/60">
            For functions &amp; events, please use our
            <a href={site.functionBookingUrl} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-porty-gold">function booking form</a>
            or call {site.phone}.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
