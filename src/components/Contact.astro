---
/* Find Us / Contact: address, tap-to-call, email, the bar & restaurant opening
   hours, an embedded map, socials, and a clear "how to book" panel. Bookings
   are taken by phone or email only. */
import { site } from '../config/site';
import BookCta from './BookCta.astro';
import SocialLinks from './SocialLinks.astro';

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(
  `${site.address.street}, ${site.address.town} ${site.address.postcode}`
)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `The Portcullis, ${site.address.street}, ${site.address.town} ${site.address.postcode}`
)}`;

const hourGroups = [
  { label: 'Bar', rows: site.hours.bar },
  { label: 'Restaurant', rows: site.hours.restaurant },
  { label: 'Breakfast (in the restaurant)', rows: site.hours.breakfast },
];
---

<section class="bg-porty-cream px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Left: details, hours, map, socials -->
      <div data-reveal class="space-y-8">
        <div class="rounded-3xl border border-porty-red/10 bg-white p-6 shadow-sm sm:p-8">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <h3 class="font-display text-lg font-semibold text-porty-red">Address</h3>
              <address class="mt-2 not-italic leading-relaxed text-porty-dark/85">
                {site.name}<br />
                {site.address.street}<br />
                {site.address.town}<br />
                {site.address.postcode}
              </address>
              <a href={mapLink} target="_blank" rel="noopener" class="mt-2 inline-block text-sm font-semibold text-porty-red underline underline-offset-2 hover:text-porty-dark">
                Get directions
              </a>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold text-porty-red">Get in touch</h3>
              <p class="mt-2 space-y-1">
                <a href={site.phoneHref} class="block font-semibold text-porty-dark hover:text-porty-red">
                  {site.phone}
                </a>
                <a href={`mailto:${site.email}`} class="block break-words text-porty-dark/85 hover:text-porty-red">
                  {site.email}
                </a>
              </p>
            </div>
          </div>

          <div class="my-6 rule-gold"></div>

          <h3 class="font-display text-lg font-semibold text-porty-red">Opening Hours</h3>
          <div class="mt-4 space-y-6">
            {
              hourGroups.map((g) => (
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.16em] text-porty-gold [text-shadow:0_0_1px_rgba(107,18,32,0.25)]">
                    {g.label}
                  </p>
                  <dl class="mt-2 divide-y divide-porty-red/10">
                    {g.rows.map((h) => (
                      <div class="flex justify-between gap-4 py-2 text-porty-dark/85">
                        <dt>{h.days}</dt>
                        <dd class="text-right font-medium">{h.time}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))
            }
          </div>

          <div class="my-6 rule-gold"></div>

          <h3 class="font-display text-lg font-semibold text-porty-red">Follow us</h3>
          <SocialLinks class="mt-3" />
        </div>

        <div class="overflow-hidden rounded-3xl border border-porty-red/10 shadow-sm">
          <iframe
            title={`Map to ${site.name}`}
            src={mapSrc}
            class="h-72 w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <!-- Right: how to book -->
      <div data-reveal class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-3xl bg-porty-dark p-8 text-porty-cream shadow-xl sm:p-10">
          <p class="font-body text-xs font-bold uppercase tracking-[0.22em] text-porty-gold">Reservations</p>
          <h3 class="mt-3 font-display text-3xl font-semibold">Book a Table</h3>
          <p class="mt-3 text-porty-cream/85">
            The best way to book is to give us a call, our team will sort you out
            in a minute. Prefer to write? Drop us an email with your date, time and
            number of people and we'll confirm as soon as we can.
          </p>
          <BookCta class="mt-6" variant="gold" onDark stack callLabel={`Call · ${site.phone}`} emailLabel={site.email} />

          <div class="my-8 h-px bg-porty-cream/15"></div>

          <p class="text-sm text-porty-cream/75">
            <span class="font-semibold text-porty-cream">Functions &amp; celebrations:</span>
            planning something bigger? Call {site.phone} or email us and ask about the
            function suite, we'll help you plan every detail.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
