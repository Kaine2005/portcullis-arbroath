---
/* Functions, the function suite. Enquiries by phone or email. Image on one
   side, details on the other. */
import { images } from '../config/site';
import BookCta from './BookCta.astro';

const occasions = [
  'Birthdays',
  'Special celebrations',
  'Weddings',
  'Baby showers',
  'Fundraising events',
  'Sporting events',
  'Funeral teas & wakes',
  'Band nights',
];
---

<section id="functions" class="scroll-mt-20 bg-porty-dark px-4 py-16 text-porty-cream sm:px-6 sm:py-24">
  <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div data-reveal class="order-2 overflow-hidden rounded-3xl shadow-xl ring-1 ring-porty-gold/20 lg:order-1">
      <img
        src={images.functions}
        alt="The function room at The Portcullis, set up for a celebration"
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
        width="1200"
        height="900"
      />
    </div>

    <div data-reveal class="order-1 lg:order-2">
      <p class="font-body text-xs font-bold uppercase tracking-[0.22em] text-porty-gold">
        Celebrate With Us
      </p>
      <h2 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
        Functions &amp; Celebrations
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-porty-cream/85">
        Our function suite is the perfect setting for occasions big and small,
        with a <strong>fully licensed bar</strong> and <strong>catering</strong>
        to match. Whatever you're marking, we'll help you do it in style.
      </p>

      <ul class="mt-6 grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2">
        {
          occasions.map((o) => (
            <li class="flex items-center gap-2.5 text-porty-cream/90">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 shrink-0 text-porty-gold" aria-hidden="true">
                <path d="M5 13l4 4L19 7" />
              </svg>
              {o}
            </li>
          ))
        }
      </ul>

      <p class="mt-8 text-porty-cream/80">
        To check dates and chat through what you need, give us a call or drop us
        an email, we'll take it from there.
      </p>
      <BookCta class="mt-4" variant="gold" callLabel="Call to enquire" emailLabel="Email your enquiry" />
    </div>
  </div>
</section>
