---
/* Functions — the function suite. Links to the existing booking form and shows
   the phone number (tap-to-call). Image on one side, details on the other. */
import { site, images } from '../config/site';

const occasions = [
  'Birthdays',
  'Special celebrations',
  'Weddings',
  'Baby showers',
  'Fundraising events',
  'Sporting events',
  'Funeral teas & wakes',
  'Band nights',
];
---

<section id="functions" class="scroll-mt-20 bg-porty-dark px-4 py-16 text-porty-cream sm:px-6 sm:py-24">
  <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div data-reveal class="order-2 overflow-hidden rounded-3xl shadow-xl ring-1 ring-porty-gold/20 lg:order-1">
      <img
        src={images.functions}
        alt="The function room at The Portcullis, set up for a celebration"
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
        width="1200"
        height="900"
      />
    </div>

    <div data-reveal class="order-1 lg:order-2">
      <p class="font-body text-xs font-bold uppercase tracking-[0.22em] text-porty-gold">
        Celebrate With Us
      </p>
      <h2 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
        Functions &amp; Celebrations
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-porty-cream/85">
        Our function suite is the perfect setting for occasions big and small,
        with a <strong>fully licensed bar</strong> and <strong>catering</strong>
        to match. Whatever you're marking, we'll help you do it in style.
      </p>

      <ul class="mt-6 grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2">
        {
          occasions.map((o) => (
            <li class="flex items-center gap-2.5 text-porty-cream/90">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 shrink-0 text-porty-gold" aria-hidden="true">
                <path d="M5 13l4 4L19 7" />
              </svg>
              {o}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={site.functionBookingUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-porty-gold px-6 py-3 font-semibold text-porty-dark transition-all duration-200 hover:-translate-y-0.5 hover:brightness-105"
        >
          Enquire about a function
        </a>
        <a
          href={site.phoneHref}
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border-2 border-porty-cream/60 px-6 py-3 font-semibold text-porty-cream transition-all duration-200 hover:bg-porty-cream hover:text-porty-red"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .5 1 1V20c0 .6-.5 1-1 1A17 17 0 0 1 3 4c0-.6.5-1 1-1h3.5c.6 0 1 .5 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1l-2.3 2.3z" />
          </svg>
          Call {site.phone}
        </a>
      </div>
    </div>
  </div>
</section>
