---
/* Decorative divider — a stylised portcullis grille (the castle gate the pub is
   named after) rendered as a small gold motif between two hairlines. Purely
   decorative, hidden from screen readers. */
interface Props {
  class?: string;
}
const { class: extra = '' } = Astro.props;
---

<div class:list={['flex items-center justify-center gap-4', extra]} aria-hidden="true">
  <span class="h-px w-16 bg-gradient-to-r from-transparent to-porty-gold sm:w-24"></span>
  <svg viewBox="0 0 44 24" class="h-6 w-11 text-porty-gold" fill="none" stroke="currentColor" stroke-width="1.6">
    <!-- top rail -->
    <line x1="2" y1="4" x2="42" y2="4" />
    <!-- mid rail -->
    <line x1="2" y1="12" x2="42" y2="12" />
    <!-- vertical bars ending in points -->
    <path d="M8 4v13l-0 0-0 0" />
    <path d="M8 4v12l0 2 0-2" />
    <path d="M8 4v14M16 4v14M24 4v14M32 4v14M40 4v14" />
    <!-- pointed feet -->
    <path d="M6 18h4l-2 3zM14 18h4l-2 3zM22 18h4l-2 3zM30 18h4l-2 3zM38 18h4l-2 3z" fill="currentColor" stroke="none" />
  </svg>
  <span class="h-px w-16 bg-gradient-to-l from-transparent to-porty-gold sm:w-24"></span>
</div>
